-- 3. Find the total credited transaction amount for each customer.

WITH summary as (
  SELECT 
    account_id,
    customer_id,
    name,
    account_type
  FROM `psyched-choir-300805.latihan.Jago_Active` A
  left join `psyched-choir-300805.latihan.Jago_Customer` C
    using (customer_id)
),

transaction as (
  SELECT
    account_id,
    count(*) as total_transaction,
    sum(case when transaction_type = "Credit" then amount else 0 end) as total_credit,
    sum(case when transaction_type = "Debit" then amount else 0 end) as total_debit,
  FROM `psyched-choir-300805.latihan.Jago_Transaction` as T
  group by account_id
)

select 
  *
from summary
left join transaction
  using (account_id)
